{
  "name": "docreview-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts vite.config.ts wdio.conf.mjs",
    "format": "biome check --write src tests scripts vite.config.ts wdio.conf.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "contracts": "node scripts/native.mjs contracts",
    "contracts:check": "node scripts/native.mjs contracts-check",
    "native:build": "node scripts/native.mjs build",
    "native:build:e2e": "node scripts/native.mjs build-e2e",
    "native:bundle:internal": "node scripts/native.mjs bundle-internal && node scripts/verify-internal.mjs",
    "native:test": "node scripts/native.mjs test",
    "native:check": "node scripts/native.mjs check",
    "native:fmt": "node scripts/native.mjs fmt"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "serialize-javascript": "7.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "9.32.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "edgedriver": false,
    "geckodriver": false,
    "fsevents": false
  }
}
